NODE_ENV=development
PORT=5000
TRUST_PROXY=1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/scanspend
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@scanspend.local
ADMIN_PASSWORD=Admin@12345
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM=no-reply@example.com

# Optional; receipt uploads and OCR return 503 until all three are configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional; configure the webhook URL as /api/v1/webhooks/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PREMIUM_MONTHLY_AMOUNT_PAISE=49900
PREMIUM_ANNUAL_AMOUNT_PAISE=499000

# Optional OpenAI-compatible chat completions provider. Statistical insights work without it.
AI_API_KEY=
AI_API_URL=
AI_MODEL=